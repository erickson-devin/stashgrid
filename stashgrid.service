[Unit]
Description=StashGrid Inventory Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__VENV_DIR__/bin/python __INSTALL_DIR__/app.py
Restart=on-failure
RestartSec=5

# Settings, including STASHGRID_SECRET_KEY, live in a root-only file that
# setup.sh creates (SG-24). Edit it, then: sudo systemctl restart stashgrid
Environment=STASHGRID_LOG_DIR=/var/log/stashgrid
EnvironmentFile=__ENV_FILE__

# Harden the service slightly
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
