[Unit]
Description=StashGrid Inventory Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__VENV_DIR__/bin/python __INSTALL_DIR__/app.py
Restart=on-failure
RestartSec=5

# Pass log directory to the app
Environment=STASHGRID_LOG_DIR=/var/log/stashgrid

# Harden the service slightly
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
