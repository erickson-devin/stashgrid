# Full-screen StashGrid on a screen attached to the Pi (SG-24).
# cage runs Chromium as a Wayland kiosk on tty1. Installed by setup.sh --display,
# which also sets STASHGRID_KIOSK=0 so the app doesn't open a second browser.
[Unit]
Description=StashGrid Kiosk Display (cage/Wayland)
After=network-online.target systemd-logind.service stashgrid.service
Wants=stashgrid.service

[Service]
Type=simple
User=__USER__
Group=__USER__
PAMName=login
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
TTYPath=/dev/tty1
StandardInput=tty
TimeoutStartSec=120
# Give the app time to start before the first page load.
ExecStartPre=/bin/sleep 10
ExecStart=/usr/bin/cage -- /usr/bin/chromium \
    --kiosk \
    --noerrdialogs \
    --disable-infobars \
    --no-first-run \
    --disable-session-crashed-bubble \
    --disable-features=TranslateUI \
    --disable-restore-session-state \
    --ignore-certificate-errors \
    --allow-insecure-localhost \
    https://localhost:5000
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
